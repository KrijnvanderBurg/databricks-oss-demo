# Spark and Python versions
SPARK_VERSION=4.1.3
PYTHON_VERSION=3.10

# Master configuration
SPARK_MASTER_WEBUI_PORT=8082
SPARK_MASTER_PORT=7077

# Worker 1 resources
SPARK_WORKER1_CORES=2
SPARK_WORKER1_MEMORY=2G
SPARK_WORKER1_WEBUI_PORT=8083

# Worker 2 resources
SPARK_WORKER2_CORES=2
SPARK_WORKER2_MEMORY=2G
SPARK_WORKER2_WEBUI_PORT=8084

# History Server
SPARK_HISTORY_WEBUI_PORT=18080

# Unity Catalog
UC_SERVER_PORT=8080
UC_UI_PORT=3000

# SeaweedFS (pinned release)
SEAWEEDFS_VERSION=4.46

# Keycloak (pinned release) - admin console at http://localhost:${KEYCLOAK_PORT}
KEYCLOAK_VERSION=26.7.3
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Lakehouse user identity for the notebook's interactive Spark session (dev-only
# credentials; must match keycloak/realm-lakehouse.json). spark-submit.sh always
# runs as the data-eng-pipeline service account instead (hardcoded in
# spark-submit.sh - it's not meant to vary for this demo).
LAKEHOUSE_USER=pietje
LAKEHOUSE_PASSWORD=pietje123