  "realm": "lakehouse",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "groups": [
    {
      "name": "data-engineers",
      "path": "/data-engineers"
    },
    {
      "name": "lakehouse-admins",
      "path": "/lakehouse-admins"
    }
  ],
  "users": [
    {
      "username": "pietje",
      "enabled": true,
      "firstName": "Pietje",
      "lastName": "Puk",
      "email": "pietje@lakehouse.local",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "pietje123",
