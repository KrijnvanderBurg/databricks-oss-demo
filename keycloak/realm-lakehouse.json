{
  "realm": "lakehouse",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "groups": [
    {
      "name": "data-engineers",
      "path": "/data-engineers"
    },
    {
      "name": "lakehouse-admins",
      "path": "/lakehouse-admins"
    }
  ],
  "users": [
    {
      "username": "service-account-data-eng-pipeline",
      "enabled": true,
      "serviceAccountClientId": "data-eng-pipeline",
      "groups": ["/data-engineers"]
    }
  ],
  "clients": [
    {
      "clientId": "lakehouse-client",
      "name": "Lakehouse client (Unity Catalog + SeaweedFS S3)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "lakehouse-client-secret",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience-lakehouse-client",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "lakehouse-client",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "data-eng-pipeline",
      "name": "Data engineering pipeline (service account, no human owner)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "data-eng-pipeline-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience-lakehouse-client",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "lakehouse-client",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "email",
            "claim.value": "data-eng-pipeline@lakehouse.local",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}
